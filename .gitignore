# Local credentials and machine-specific configuration
config.ini
campus_auth_password.txt
credential.dat
*.credential

# Runtime logs and state
*.log
*.log.*
*.pid
*.tmp
*.temp

# Generated installers and build tools
.tools/
build/
dist/
*.msi

# Release signing keys and scratch work; a private signing key must never be
# committed. Keep the offline release key outside the checkout entirely.
.release-key/
*.key
.scratch/

# Local research notes gathered for a decision; not part of the application.
_csign_research/

# Captcha model training artifacts. The shipped inference model is
# data/captcha/model.npz and IS committed (the build bundles it); everything else
# under data/captcha is local training/labelling output, not part of the app.
data/captcha/*
!data/captcha/model.npz

# Python caches, test output, and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/
env/

# Internal agent design and execution notes
docs/superpowers/
.worktrees/

# 本地探测与诊断脚本：含真实校园 URL、账号样例和内部调研过程，不随源码发布。
# 例外：sign_release.py 是发布流程的一部分（release.yml 会调用它），必须保持跟踪。
tools/**
!tools/sign_release.py

# Editor and operating-system files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
